# Business OS: environment contract. Copy to .env (`cp .env.example .env`) and replace every dev placeholder.
# .env is gitignored. This file holds NO real secrets: the values below are dev-safe placeholders.
#
# Replace all secret placeholders in one go (run in the repo root, in WSL, right after the copy):
#   sed -i \
#     -e "s/dev-postgres-pw/$(openssl rand -hex 16)/g" \
#     -e "s/dev-owner-pw/$(openssl rand -hex 16)/g" \
#     -e "s/dev-app-pw/$(openssl rand -hex 16)/g" \
#     -e "s/dev-zitadel-db-pw/$(openssl rand -hex 16)/g" \
#     -e "s/bos-dev-masterkey-0123456789abcd/$(openssl rand -hex 16)/g" \
#     -e "s/bos-dev-login-cookie-secret-0123456789abcdef/$(openssl rand -hex 32)/g" \
#     -e "s/Dev-Admin-Passw0rd-1#/Bos-$(openssl rand -hex 8)-Aa1#/g" \
#     -e "s/^PGBACKREST_REPO1_CIPHER_PASS=$/PGBACKREST_REPO1_CIPHER_PASS=$(openssl rand -hex 32)/" .env
# (hex only, on purpose: characters like / + = would break the connection URLs below)
#
# Compose does not read this file by itself from the repo root: always pass --env-file .env
# (the pnpm stack:* scripts do).

# ---------------------------------------------------------------- Postgres
# Superuser password of the Postgres container. Used by admin tools and the backup scripts only.
POSTGRES_PASSWORD=dev-postgres-pw
# Password of role bos_owner (owns database "bos", runs migrations). Applied on first start of an EMPTY data volume.
BOS_DB_OWNER_PASSWORD=dev-owner-pw
# Password of role bos_app (runtime role, data changes only). Applied on first start of an EMPTY data volume.
BOS_DB_APP_PASSWORD=dev-app-pw
# Password of role zitadel (owns database "zitadel"). Applied on first start of an EMPTY data volume.
ZITADEL_DB_PASSWORD=dev-zitadel-db-pw
# Passphrase that encrypts the pgBackRest backup repository (AES-256). Empty on purpose: compose refuses to start
# without it. infra/scripts/make-dev-env.sh fills in a random value; otherwise use `openssl rand -hex 32`.
# !! Back it up together with ZITADEL_MASTERKEY: without it no backup can be restored. Never change it afterwards
# !! (a repository keeps the passphrase it was created with). An .env made before this variable existed must get it
# !! added by hand, and the old unencrypted repository must be replaced (see infra/postgres/pgbackrest.conf).
PGBACKREST_REPO1_CIPHER_PASS=
# Runtime connection (role bos_app) for apps running on the host. Keep the password equal to BOS_DB_APP_PASSWORD.
DATABASE_URL=postgresql://bos_app:dev-app-pw@127.0.0.1:5432/bos
# Migration connection (role bos_owner) for the migrate job and the seed tool. Keep equal to BOS_DB_OWNER_PASSWORD.
DATABASE_MIGRATE_URL=postgresql://bos_owner:dev-owner-pw@127.0.0.1:5432/bos

# ---------------------------------------------------------------- Valkey
# Queue and session store, for apps running on the host (no password, bound to 127.0.0.1 only).
VALKEY_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------- OIDC (login through ZITADEL)
# Public issuer URL. It must be identical in the browser, the Next server, the API and k6.
OIDC_ISSUER=https://auth.localhost
# ZITADEL project id (the token audience). Empty until `pnpm seed` runs; the seed writes it to .dev/zitadel.env.
OIDC_AUDIENCE=
# Client id of the Workspace OIDC app. Empty until `pnpm seed` runs (see .dev/zitadel.env).
OIDC_CLIENT_ID=
# Where ZITADEL sends the browser back after login.
OIDC_REDIRECT_URI=https://app.localhost/auth/callback

# ---------------------------------------------------------------- Apps
# Public address of the Workspace app (the browser sees this).
WORKSPACE_PUBLIC_URL=https://app.localhost
# How the Workspace server reaches the API. Host dev: 127.0.0.1:3001. In the `app` profile compose sets http://api:3001.
API_INTERNAL_URL=http://127.0.0.1:3001
# Port the API listens on.
API_PORT=3001
# Port of the internal metrics server: 9464 for the API, 9465 for the worker (compose sets both for the app profile).
METRICS_PORT=9464
# Log level for the API, worker and workspace: trace, debug, info, warn, error.
LOG_LEVEL=info

# ---------------------------------------------------------------- ZITADEL
# !! ZITADEL_MASTERKEY must be EXACTLY 32 characters, can NEVER be changed after the first start, and must be
# !! backed up together with the database backups: without it the encrypted data in a restored database is unusable.
ZITADEL_MASTERKEY=bos-dev-masterkey-0123456789abcd
# Signs the login UI session cookie. At least 32 characters.
ZITADEL_LOGIN_COOKIE_SECRET=bos-dev-login-cookie-secret-0123456789abcdef
# First admin user (human). An email-style name is used as the login name as it is; a bare name would get the
# organisation domain appended (check the exact login name after the first boot).
ZITADEL_ADMIN_USERNAME=admin@techrida.localhost
# First admin password. ZITADEL's policy needs 8+ characters with upper case, lower case, a digit and a symbol.
ZITADEL_ADMIN_PASSWORD=Dev-Admin-Passw0rd-1#

# ---------------------------------------------------------------- Edge (Caddy)
# Where Caddy sends app.localhost. Dev default: a dev server on the host (must listen on 0.0.0.0).
# For the `app` profile run:  WORKSPACE_UPSTREAM=workspace:3000 API_UPSTREAM=api:3001 docker compose ...
WORKSPACE_UPSTREAM=host.docker.internal:3000
# Where Caddy sends api.localhost. Dev default: a dev server on the host (must listen on 0.0.0.0).
API_UPSTREAM=host.docker.internal:3001
# Address Caddy binds to in production (the server's private network IP). Unused in dev (dev binds 127.0.0.1).
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------- Dev tooling
# Caddy's root certificate, so Node (host and containers) trusts https://*.localhost. Written by export-dev-ca.sh.
NODE_EXTRA_CA_CERTS=.dev/caddy-root.crt
# Persona list written by the seed and read by the dev-only persona switcher. Never present in production.
BOS_DEV_PERSONAS_FILE=.dev/personas.json

# ---------------------------------------------------------------- Optional (production, uncomment to use)
# Public hostnames. Defaults are the dev names.
# AUTH_HOST=auth.localhost
# APP_HOST=app.localhost
# API_HOST=api.localhost
# MAIL_HOST=mail.localhost
# Expiry of the ZITADEL bootstrap tokens (default 2099 for dev). REQUIRED with compose.prod.yaml: use a short date.
# ZITADEL_PAT_EXPIRATION=2099-01-01T00:00:00Z
# Caddy TLS mode: "internal" (Caddy's own CA) or an email address for Let's Encrypt.
# CADDY_TLS=internal
# k6 only: override the read p95 threshold in milliseconds (proves the gate can fail).
# K6_READ_P95_MS=300
