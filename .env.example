# Business OS: environment contract. Copy to .env (`cp .env.example .env`) and replace every dev placeholder.
# .env is gitignored. This file holds NO real secrets: the values below are dev-safe placeholders.
#
# Easiest: `bash infra/scripts/make-dev-env.sh` (repo root, WSL). It creates .env with random secrets, and on an
# existing .env it only ADDS keys that are missing or empty (never overwrites a value).
#
# By hand: every secret below is blank on purpose, so a bare `cp .env.example .env` cannot start a stack with shared
# passwords (compose refuses to start on an empty required value). Fill each blank with `openssl rand -hex 16`
# (ZITADEL_MASTERKEY: exactly 32 characters, so hex 16), `openssl rand -hex 32` (cookie and other secrets) or, for
# ZITADEL_ADMIN_PASSWORD, `Bos-$(openssl rand -hex 8)-Aa1#`. Keep the passwords inside DATABASE_URL and
# DATABASE_MIGRATE_URL equal to BOS_DB_APP_PASSWORD and BOS_DB_OWNER_PASSWORD (hex only, on purpose: characters like
# / + = would break the connection URLs below).
#
# Compose does not read this file by itself from the repo root: always pass --env-file .env
# (the pnpm stack:* scripts do).

# ---------------------------------------------------------------- Postgres
# Superuser password of the Postgres container. Used by admin tools and the backup scripts only.
POSTGRES_PASSWORD=
# Password of role bos_owner (owns database "bos", runs migrations). Applied on first start of an EMPTY data volume.
BOS_DB_OWNER_PASSWORD=
# Password of role bos_app (runtime role, data changes only). Applied on first start of an EMPTY data volume.
BOS_DB_APP_PASSWORD=
# Password of role zitadel (owns database "zitadel"). Applied on first start of an EMPTY data volume.
ZITADEL_DB_PASSWORD=
# Passphrase that encrypts the pgBackRest backup repository (AES-256). Empty on purpose: compose refuses to start
# without it. infra/scripts/make-dev-env.sh fills in a random value; otherwise use `openssl rand -hex 32`.
# !! Back it up together with ZITADEL_MASTERKEY: without it no backup can be restored. Never change it afterwards
# !! (a repository keeps the passphrase it was created with). An .env made before this variable existed must get it
# !! added by hand, and the old unencrypted repository must be replaced (see infra/postgres/pgbackrest.conf).
PGBACKREST_REPO1_CIPHER_PASS=
# Runtime connection (role bos_app) for apps running on the host. Keep the password equal to BOS_DB_APP_PASSWORD.
DATABASE_URL=postgresql://bos_app:dev-app-pw@127.0.0.1:5432/bos
# Migration connection (role bos_owner) for the migrate job and the seed tool. Keep equal to BOS_DB_OWNER_PASSWORD.
DATABASE_MIGRATE_URL=postgresql://bos_owner:dev-owner-pw@127.0.0.1:5432/bos
# Optional per-transaction limits for host-run api and worker (compose does not pass them to the containers, which
# use the defaults). A write waiting longer than DB_LOCK_TIMEOUT_MS for a lock fails and the API answers 503 db_busy
# with Retry-After; a transaction idle longer than DB_IDLE_IN_TX_TIMEOUT_MS is ended by Postgres.
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TX_TIMEOUT_MS=30000

# ---------------------------------------------------------------- Valkey
# Password of the Valkey server (--requirepass). Empty on purpose: compose refuses to start without it.
# infra/scripts/make-dev-env.sh fills in a random value (and adds it to an older .env); otherwise `openssl rand -hex 32`.
# Hex only: it is placed inside redis:// URLs. Compose passes it to every container as part of VALKEY_URL.
VALKEY_PASSWORD=
# Queue and session store, for apps running on the host (bound to 127.0.0.1 only). Keep the password equal to
# VALKEY_PASSWORD (make-dev-env.sh replaces the placeholder below with it).
VALKEY_URL=redis://:dev-valkey-pw@127.0.0.1:6379

# ---------------------------------------------------------------- OIDC (login through ZITADEL)
# Public issuer URL. It must be identical in the browser, the Next server, the API and k6.
OIDC_ISSUER=https://auth.localhost
# ZITADEL project id (the token audience). Empty until `pnpm seed` runs; the seed writes it to .dev/zitadel.env.
OIDC_AUDIENCE=
# Client id of the Workspace OIDC app. Empty until `pnpm seed` runs (see .dev/zitadel.env).
OIDC_CLIENT_ID=
# Where ZITADEL sends the browser back after login.
OIDC_REDIRECT_URI=https://app.localhost/auth/callback

# ---------------------------------------------------------------- Apps
# Public address of the Workspace app (the browser sees this).
WORKSPACE_PUBLIC_URL=https://app.localhost
# Public address of the customer portal: the base of the links in customer emails. Required in production.
PORTAL_PUBLIC_URL=https://portal.localhost
# Shared secret that signs Postal's bounce webhook (POST /v1/hooks/postal). At least 32 characters when set;
# while it is unset the webhook answers 401 to everything, so no bounce is recorded.
POSTAL_WEBHOOK_SECRET=
# How the Workspace server reaches the API. Host dev: 127.0.0.1:3001. In the `app` profile compose sets http://api:3001.
API_INTERNAL_URL=http://127.0.0.1:3001
# Port the API listens on.
API_PORT=3001
# Port of the internal metrics server: 9464 for the API, 9465 for the worker (compose sets both for the app profile).
METRICS_PORT=9464
# Log level for the API, worker and workspace: trace, debug, info, warn, error.
LOG_LEVEL=info
# Dev only, leave commented: raises the login limit (CR-03, 20 per minute per client IP) for local e2e runs, because all
# local traffic shares one Caddy IP. Whole number 21 to 10000. The workspace refuses to start with it unless
# WORKSPACE_PUBLIC_URL is localhost or *.localhost. compose.dev.yaml already sets 200 for the `app` profile; set it
# here to use another value. Never set it in production.
# BOS_DEV_LOGIN_RATE_LIMIT=200
# Optional footer links on the Workspace's sign-in error, no-access and staff-only pages. Each is an absolute http(s)
# URL; leave one empty and its link is hidden. The login screen has its own pair (LOGIN_HELP_URL, LOGIN_PRIVACY_URL).
BOS_HELP_URL=
BOS_PRIVACY_URL=

# ---------------------------------------------------------------- Session encryption (Workspace)
# Key that encrypts the session data the Workspace stores in Valkey: 32 random bytes, base64 (AES-256).
# Empty on purpose. infra/scripts/make-dev-env.sh fills in a random value (and adds it to an older .env); otherwise
# use `openssl rand -base64 32`. Required by compose.prod.yaml. Not read by any app code yet (the session work uses it).
# !! Changing it makes every stored session unreadable (everyone is logged out). Rotate by adding a new key under a
# !! new SESSION_ENC_KEY_ID, never by silently replacing the value.
SESSION_ENC_KEY=
# Label of the key above (k1, k2, ...). Stored next to each encrypted session so a later key rotation can tell
# which key encrypted it.
SESSION_ENC_KEY_ID=k1

# ---------------------------------------------------------------- Session encryption (customer portal)
# Same format and rules as SESSION_ENC_KEY above, but a separate key: the portal and the Workspace never share one.
# Empty on purpose. infra/scripts/make-dev-env.sh fills in a random value (and adds it to an older .env); otherwise
# use `openssl rand -base64 32`. Compose passes it to the portal container as SESSION_ENC_KEY; required by
# compose.prod.yaml. Same rotation rule: add a new key under a new id, never silently replace the value.
PORTAL_SESSION_ENC_KEY=
# Label of the portal key above (p1, p2, ...). `p1`, not `k1`, so a portal session can never be read as a Workspace one.
PORTAL_SESSION_ENC_KEY_ID=p1

# ---------------------------------------------------------------- ZITADEL
# !! ZITADEL_MASTERKEY must be EXACTLY 32 characters, can NEVER be changed after the first start, and must be
# !! backed up together with the database backups: without it the encrypted data in a restored database is unusable.
ZITADEL_MASTERKEY=
# Signs the login UI session cookie. At least 32 characters.
ZITADEL_LOGIN_COOKIE_SECRET=
# First admin user (human). An email-style name is used as the login name as it is; a bare name would get the
# organisation domain appended (check the exact login name after the first boot).
ZITADEL_ADMIN_USERNAME=admin@techrida.localhost
# First admin password. ZITADEL's policy needs 8+ characters with upper case, lower case, a digit and a symbol.
ZITADEL_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Edge (Caddy)
# Where Caddy sends app.localhost. Dev default: a dev server on the host (must listen on 0.0.0.0).
# For the `app` profile run:  WORKSPACE_UPSTREAM=workspace:3000 API_UPSTREAM=api:3001 docker compose ...
WORKSPACE_UPSTREAM=host.docker.internal:3000
# Where Caddy sends api.localhost. Dev default: a dev server on the host (must listen on 0.0.0.0).
API_UPSTREAM=host.docker.internal:3001
# Where Caddy sends portal.localhost. Dev default: the portal's `next dev` on the host (port 3002, must listen on 0.0.0.0).
# For the `app` profile run:  PORTAL_UPSTREAM=portal:3000 docker compose ...  (together with the two above)
PORTAL_UPSTREAM=host.docker.internal:3002
# Address Caddy binds to in production. Choose the server interface to serve over HTTPS.
# Unused in dev (dev binds 127.0.0.1).
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------- Dev tooling
# Caddy's root certificate, so Node (host and containers) trusts https://*.localhost. Written by export-dev-ca.sh.
NODE_EXTRA_CA_CERTS=.dev/caddy-root.crt
# Persona list written by the seed and read by the dev-only persona switcher. Never present in production.
BOS_DEV_PERSONAS_FILE=.dev/personas.json
# Optional, next dev only: isolates browser cookies for instances sharing a hostname across ports.
# Each concurrent instance needs a different namespace. Production ignores this setting.
# BOS_DEV_COOKIE_NAMESPACE=p0

# ---------------------------------------------------------------- Optional (production, uncomment to use)
# Public hostnames. Defaults are the dev names.
# AUTH_HOST=auth.localhost
# APP_HOST=app.localhost
# API_HOST=api.localhost
# MAIL_HOST=mail.localhost
# PORTAL_HOST=portal.localhost
# Expiry of the ZITADEL bootstrap tokens (default 2099 for dev). REQUIRED with compose.prod.yaml: use a short date.
# ZITADEL_PAT_EXPIRATION=2099-01-01T00:00:00Z
# Caddy TLS mode: "internal" (Caddy's own CA) or an email address for Let's Encrypt.
# CADDY_TLS=internal
# k6 only: override the read p95 threshold in milliseconds (proves the gate can fail).
# K6_READ_P95_MS=300

# Development only: exact extra HTTPS origins trusted by the instant account switcher.
# Comma-separated origins, including explicit ports; no wildcard host trust. Empty keeps local-only defaults.
BOS_DEV_TRUSTED_ORIGINS=
# Optional private HTTPS identity API origin for privileged dev login-client calls.
# Keep external browser OIDC/login bridges restricted; never expose this service token to the browser.
BOS_DEV_IDENTITY_API_URL=
# Optional development Prometheus viewer (obs profile). Use a different port per phase.
# PROMETHEUS_BIND_ADDR=127.0.0.1
# PROMETHEUS_PORT=19090

# Optional links in the Login V2 footer. Absolute HTTP(S) URLs. Blank hides the item.
# LOGIN_HELP_URL=https://help.example.com/sign-in
# LOGIN_PRIVACY_URL=https://example.com/privacy

# Production email for new ZITADEL instances (dev uses Mailpit after pnpm seed).
# Set HOST and FROM together. For an authenticated server set both USER and PASSWORD.
# Use TLS=true for encrypted delivery, typically with a submission port such as 587.
# Keep credentials in the deployment environment / secret store.
# Existing instances configure or rotate the active Email Provider in ZITADEL.
# ZITADEL_SMTP_HOST=smtp.example.com:587
# ZITADEL_SMTP_FROM=login@example.com
# ZITADEL_SMTP_FROM_NAME=Business OS
# ZITADEL_SMTP_TLS=true
# ZITADEL_SMTP_USER=
# ZITADEL_SMTP_PASSWORD=
