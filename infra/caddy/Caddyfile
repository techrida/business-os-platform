# Business OS edge proxy. Hostnames, TLS mode and upstreams come from the environment (see compose.yaml).
# Dev: *.localhost with Caddy's own CA (`tls internal`). Browsers send *.localhost to 127.0.0.1 by themselves.

(site_tls) {
	tls {$CADDY_TLS:internal}
}

# Upstream connection reuse for the Node servers (workspace, portal, API, Login V2 UI).
# Why: Node closes an idle keep-alive connection after 5 s (http.Server keepAliveTimeout, also Next.js), while Caddy
# keeps an idle upstream connection for 2 min by default. A request that Caddy sends down a connection Node closed a
# moment earlier fails with EOF and the browser gets a 502 (seen on bos-testrun, behind a socat relay that also drops
# idle connections). Two settings fix it together:
#   - keepalive 3s: Caddy closes its idle upstream connections after 3 s, always before the upstream's 5 s, so it
#     rarely reuses a connection the upstream is about to drop.
#   - lb_retries 1 / lb_try_duration 3s: a failed connect, and a GET whose reused connection was dropped, is retried
#     once on a fresh connection instead of answering 502. Caddy never resends a write (POST, PUT, PATCH, DELETE) after
#     the connection opened, so writes rely on keepalive staying below the upstream's idle timeout.
# Keep keepalive below the upstream's idle timeout if that is ever raised.
(node_upstream) {
	lb_retries 1
	lb_try_duration 3s
	transport http {
		keepalive 3s
	}
}

# ZITADEL: API (gRPC, Connect, OIDC) on h2c plus the Login V2 UI, same routing as ZITADEL's official compose.
{$AUTH_HOST:auth.localhost} {
	import site_tls

	# "/" opens the login UI
	@root path /
	rewrite @root /ui/v2/login/

	# Prod only: compose.prod.yaml mounts infra/caddy/auth-restricted.caddy here, which answers 404 for everything
	# except the paths OIDC sign-in needs (no console, no admin APIs). Dev mounts nothing, a glob that matches no
	# file imports nothing, so dev stays fully open (the e2e logins and the seed tool need that).
	import /etc/caddy/auth.d/*

	@login path /ui/v2/login /ui/v2/login/*
	handle @login {
		reverse_proxy zitadel-login:3000 {
			import node_upstream
		}
	}

	# convenience alias: /api/<path> reaches the API as /<path>
	handle_path /api/* {
		reverse_proxy h2c://zitadel-api:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy h2c://zitadel-api:8080 {
			flush_interval -1
		}
	}
}

# Workspace (Next.js staff app)
{$APP_HOST:app.localhost} {
	import site_tls
	reverse_proxy {$WORKSPACE_UPSTREAM:workspace:3000} {
		import node_upstream
	}
}

# Customer portal (Next.js, apps/portal). Same shape as the workspace site: security headers (CSP, nosniff,
# frame-deny) come from the app's own next.config.ts, and the login limiter is in the app too.
{$PORTAL_HOST:portal.localhost} {
	import site_tls
	reverse_proxy {$PORTAL_UPSTREAM:portal:3000} {
		import node_upstream
	}
}

# API. /metrics is never served here (metrics live on an internal port).
{$API_HOST:api.localhost} {
	import site_tls

	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	handle {
		reverse_proxy {$API_UPSTREAM:api:3001} {
			header_up X-Request-Id {http.request.uuid}
			import node_upstream
		}
	}
}

# Mailpit web UI (dev only: in prod there is no mailpit container, so this host answers 502)
{$MAIL_HOST:mail.localhost} {
	import site_tls
	reverse_proxy {$MAIL_UPSTREAM:mailpit:8025}
}
