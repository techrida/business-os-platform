#!/bin/sh
# Refuses a push of anything unfit for the public repository. Installed by `pnpm install` (the root
# `prepare` script sets core.hooksPath to .githooks). Bypass in an emergency: git push --no-verify.
here=$(dirname "$0")
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH, so the public-repo check cannot run. Install Node 24 or push with --no-verify." >&2
  exit 1
fi
exec node "$here/../tools/check-public-repo.mjs" --pre-push "$@"
